{
  "name": "Spam Checker",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Contact Form",
        "formDescription": "Submit your enquiry",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Name",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Message",
              "fieldType": "textarea",
              "requiredField": false
            }
          ]
        },
        "options": {}
      },
      "id": "1a111111-1111-4111-8111-111111111111",
      "name": "On form submission",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [260, 360],
      "webhookId": "spam-checker-form"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "b2222222-2222-4222-8222-222222222222",
              "leftValue": "={{ $json.Message }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "2b222222-2222-4222-8222-222222222222",
      "name": "empty message filter",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [480, 360]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a spam detection assistant. Analyze the incoming form submission (name, email, message) and determine whether it is spam or a genuine enquiry. Consider signals such as promotional language, suspicious links, irrelevant content, gibberish, or scam patterns. Respond ONLY with a JSON object in the exact format: {\"isSpam\": true or false, \"reason\": \"short explanation\"}"
            },
            {
              "role": "user",
              "content": "=Name: {{ $json.Name }}\nEmail: {{ $json.Email }}\nMessage: {{ $json.Message }}"
            }
          ]
        },
        "options": {
          "responseFormat": "json_object"
        }
      },
      "id": "3c333333-3333-4333-8333-333333333333",
      "name": "AI Spam checker",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.6,
      "position": [700, 360],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "4d444444-4444-4444-8444-444444444444",
              "leftValue": "={{ JSON.parse($json.message.content).isSpam }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5e555555-5555-4555-8555-555555555555",
      "name": "Is spam?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [920, 360]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Spam Sheet",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Name": "={{ $('empty message filter').item.json.Name }}",
            "Email": "={{ $('empty message filter').item.json.Email }}",
            "Message": "={{ $('empty message filter').item.json.Message }}",
            "Reason": "={{ JSON.parse($json.message.content).reason }}"
          }
        },
        "options": {}
      },
      "id": "6f666666-6666-4666-8666-666666666666",
      "name": "Spam Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1160, 260],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Genuine enquiries",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Name": "={{ $('empty message filter').item.json.Name }}",
            "Email": "={{ $('empty message filter').item.json.Email }}",
            "Message": "={{ $('empty message filter').item.json.Message }}"
          }
        },
        "options": {}
      },
      "id": "7a777777-7777-4777-8777-777777777777",
      "name": "Genuine enquiries",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1160, 460],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    }
  ],
  "connections": {
    "On form submission": {
      "main": [
        [
          {
            "node": "empty message filter",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "empty message filter": {
      "main": [
        [
          {
            "node": "AI Spam checker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Spam checker": {
      "main": [
        [
          {
            "node": "Is spam?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is spam?": {
      "main": [
        [
          {
